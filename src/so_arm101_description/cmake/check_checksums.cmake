# Test: files recorded in third_party/SO-ARM100/SHA256SUMS match, and meshes/ holds exactly the recorded STL files.
#   -DPKG_DIR=<package source dir>
file(STRINGS "${PKG_DIR}/third_party/SO-ARM100/SHA256SUMS" lines)
set(listed_meshes "")
set(n 0)
foreach(line IN LISTS lines)
  if(NOT line MATCHES "^([0-9a-f]+)  (.+)$")
    message(FATAL_ERROR "bad line in SHA256SUMS: ${line}")
  endif()
  set(sum "${CMAKE_MATCH_1}")
  set(rel "${CMAKE_MATCH_2}")
  if(NOT EXISTS "${PKG_DIR}/${rel}")
    message(FATAL_ERROR "missing file listed in SHA256SUMS: ${rel}")
  endif()
  file(SHA256 "${PKG_DIR}/${rel}" actual)
  if(NOT actual STREQUAL sum)
    message(FATAL_ERROR "sha256 mismatch: ${rel}\n  recorded ${sum}\n  actual   ${actual}")
  endif()
  if(rel MATCHES "^meshes/")
    list(APPEND listed_meshes "${rel}")
  endif()
  math(EXPR n "${n}+1")
endforeach()
list(LENGTH listed_meshes n_meshes)
if(NOT n_meshes EQUAL 13)
  message(FATAL_ERROR "SHA256SUMS lists ${n_meshes} meshes, expected 13")
endif()
file(GLOB found RELATIVE "${PKG_DIR}" "${PKG_DIR}/meshes/*")
list(SORT found)
list(SORT listed_meshes)
if(NOT found STREQUAL listed_meshes)
  message(FATAL_ERROR "meshes/ differs from SHA256SUMS\n  found:  ${found}\n  listed: ${listed_meshes}")
endif()
message(STATUS "urdf_original_checksums: ${n} files OK (${n_meshes} meshes)")
