<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="so101_new_calib_ros2_control" params="name initial_positions_file use_fake_hardware:=true hardware:=feetech serial_port:=/dev/ttyACM0 calibration_file:='' read_only:=true acceleration:=50 torque_limit:=1000 apply_servo_config:=false probe_lock_sram:=false">
        <!-- hardware は feetech だけ。それ以外は、use_fake_hardware の値に関わらず、xacro の展開で失敗させる
             （xacro の property は遅延評価なので、xacro:if の本文で評価する） -->
        <xacro:if value="${hardware != 'feetech'}">${xacro.fatal('hardware:=' + str(hardware) + ' is not supported: the LeRobot path was removed from this workspace; use hardware:=feetech (the removed code is in git tag stage2c-done)')}</xacro:if>
        <xacro:property name="initial_positions" value="${load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <xacro:if value="${use_fake_hardware}">
                    <!-- シミュレーション用 (fake) -->
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:if>
                <xacro:unless value="${use_fake_hardware}">
                    <xacro:if value="${hardware == 'feetech'}">
                        <!-- 実機用(自前ドライバ): Feetech STS3215 を直接制御。read_only=true は読み取り専用、false で書き込みモード -->
                        <plugin>so_arm101_hardware/Sts3215System</plugin>
                        <param name="serial_port">${serial_port}</param>
                        <param name="calibration_file">${calibration_file}</param>
                        <param name="read_only">${read_only}</param>
                        <param name="acceleration">${acceleration}</param>
                        <param name="torque_limit">${torque_limit}</param>
                        <param name="apply_servo_config">${apply_servo_config}</param>
                        <param name="probe_lock_sram">${probe_lock_sram}</param>
                    </xacro:if>
                </xacro:unless>
            </hardware>
            <joint name="shoulder_pan">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['shoulder_pan']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="shoulder_lift">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['shoulder_lift']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="elbow_flex">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['elbow_flex']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="wrist_flex">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['wrist_flex']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="wrist_roll">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['wrist_roll']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="gripper">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['gripper']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>

