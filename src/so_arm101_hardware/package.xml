<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>so_arm101_hardware</name>
  <version>0.1.1</version>
  <description>ros2_control hardware interface for the SO101 robot.</description>
  <maintainer email="hirohiro20051009@gmail.com">hiro</maintainer>
  <license>MIT</license>
  <author email="nimicu21@gmail.com">Nimrod</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS2 Control Dependencies -->
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>yaml-cpp</depend>

  <exec_depend>rmw_cyclonedds_cpp</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- This tag exports the plugin definition file -->
    <hardware_interface plugin_description_file="so_arm101_hardware_plugins.xml"/>
  </export>
</package>
