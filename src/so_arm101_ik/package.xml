<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>so_arm101_ik</name>
  <version>0.1.0</version>
  <description>Analytic forward/inverse kinematics of the SO-ARM101 arm and the URDF kinematic chain used to check it (pure Python, numpy only)</description>
  <maintainer email="hirohiro20051009@gmail.com">hiro</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_index_python</test_depend>
  <test_depend>so_arm101_description</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
