<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>so_arm101_bringup</name>
  <version>0.1.1</version>
  <description>Bringup configuration for the SO101 robot</description>
  <maintainer email="hirohiro20051009@gmail.com">hiro</maintainer>
  <license>MIT</license>
  <author email="nimicu21@gmail.com">Nimrod</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>so_arm101_description</exec_depend>
  <exec_depend>so_arm101_moveit_config</exec_depend>
  <exec_depend>so_arm101_controller</exec_depend>
  <exec_depend>so_arm101_hardware</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
